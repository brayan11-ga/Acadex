# Acadex — configuración local de Docker Compose
# Copiar a .env. No subir .env a GitHub.

# Base de datos local
DB_USER=acadex_dev
DB_PASSWORD=acadex_local_only
DB_NAME=acadex_dev

# Clave de desarrollo local; cambiarla si se usa fuera de desarrollo
SECRET_KEY=local-development-secret-change-this-before-use
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Puertos locales
ACADEX_DB_PORT=5433
ACADEX_API_PORT=8000
ACADEX_FRONTEND_PORT=5173
ACADEX_MAILPIT_UI_PORT=8025
ACADEX_MAILPIT_SMTP_PORT=1025

# URLs locales
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
MAIL_FROM=no-reply@acadex.local