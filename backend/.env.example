# Acadex — configuración local del backend
# Copiar a backend/.env. No subir backend/.env a GitHub.

APP_ENV=development

# Base de datos para ejecutar el backend directamente en el equipo.
# Con Docker Compose, DB_HOST y DB_PORT se sobrescriben a db:5432.
DB_USER=acadex_dev
DB_PASSWORD=acadex_local_only
DB_HOST=localhost
DB_PORT=5433
DB_NAME=acadex_dev
DB_SSLMODE=prefer

# Autenticación
SECRET_KEY=local-development-secret-change-this-before-use
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Inteligencia artificial:
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_USER_DAILY_LIMIT=1
GEMINI_GLOBAL_DAILY_LIMIT=18

# Adjuntos: configuración local
ATTACHMENTS_ENABLED=false
ATTACHMENTS_STORAGE_BACKEND=local

# Frontend y CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Correo local (Mailpit)
PASSWORD_RESET_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@acadex.local