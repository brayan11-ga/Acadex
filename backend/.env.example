# Esta plantilla es para desarrollo local. En el panel del backend, configura
# los valores de producción con tus dominios y credenciales; no subas el .env.
# APP_ENV=production
# CORS_ORIGINS=https://<dominio-frontend>
# FRONTEND_URL=https://<dominio-frontend>
# DB_SSLMODE=require
# SECRET_KEY=<clave-aleatoria-de-al-menos-32-caracteres>
# GEMINI_API_KEY=<clave-de-AI-Studio; solo en el backend>
# PASSWORD_RESET_ENABLED=true requiere SMTP_HOST, MAIL_FROM y SMTP_STARTTLS=true.
# Sin proveedor SMTP listo, usa PASSWORD_RESET_ENABLED=false.
# Para adjuntos persistentes en producción: crea en Supabase un bucket privado
# llamado acadex-adjuntos, con límite de 5 MiB y MIME PDF, DOCX, JPG y PNG.
# Configura la clave secreta solo en el backend (nunca en Vite/frontend).
# Usa SUPABASE_SECRET_KEY (sb_secret_...) si aparece en tu panel; la clave
# SUPABASE_SERVICE_ROLE_KEY antigua sigue admitida temporalmente.
# ATTACHMENTS_ENABLED=true
# ATTACHMENTS_STORAGE_BACKEND=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=<clave-secreta-del-backend>
# SUPABASE_SERVICE_ROLE_KEY=<solo-para-proyectos-con-clave-antigua>
# SUPABASE_STORAGE_BUCKET=acadex-adjuntos

DB_USER=acadex_dev
DB_PASSWORD=acadex_local_only
DB_HOST=localhost
DB_PORT=5433
DB_NAME=acadex_dev
DB_SSLMODE=prefer

SECRET_KEY=local-development-secret-change-this-before-use
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GEMINI_API_KEY=
GEMINI_USER_DAILY_LIMIT=1
GEMINI_GLOBAL_DAILY_LIMIT=18
ATTACHMENTS_ENABLED=false
ATTACHMENTS_STORAGE_BACKEND=local

APP_ENV=development
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_ENABLED=true

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@acadex.local

# Host port used only by Docker Compose. The backend container uses db:5432.
ACADEX_DB_PORT=5433
